{
  "name": "commerce-ops-desk-frontend",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "capture:demo-entry": "UPDATE_README_SCREENSHOTS=1 playwright test e2e/readme-screenshots.spec.ts --project=desktop-chromium --workers=1",
    "test": "vitest run src",
    "test:e2e": "playwright test --config=playwright.config.ts",
    "test:watch": "vitest src",
    "typecheck": "tsc -b --pretty false && tsc --project e2e/tsconfig.json --pretty false"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
