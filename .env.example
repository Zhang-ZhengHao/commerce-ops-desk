# Local development only. Hosted environments inject PORT at runtime.
COMMERCE_OPS_ENVIRONMENT=development
COMMERCE_OPS_DATABASE_URL=sqlite+pysqlite:///./data/commerce_ops.db
COMMERCE_OPS_API_MAX_REQUEST_BODY_BYTES=16384
COMMERCE_OPS_DEMO_SOURCE_HOURLY_LIMIT=10
COMMERCE_OPS_DEMO_ACTIVE_WORKSPACE_LIMIT=500
COMMERCE_OPS_DEMO_WORKSPACE_TTL_HOURS=4
COMMERCE_OPS_DEMO_ROLE_WRITE_LIMIT=32
PORT=8000

# Recommended: set COMMERCE_OPS_SESSION_SECRET to a stable value of at least
# 32 bytes. Never commit that value.

# Alternative: load the secret from a regular file owned by the runtime user.
# The file must contain at least 32 bytes and have permissions set to 0600.
# COMMERCE_OPS_SESSION_SECRET_FILE=/run/secrets/commerce-ops-session-secret

# Outside production, when neither option is set, the hosted launcher creates and
# reuses data/.session-secret with the required 0600 permissions.
